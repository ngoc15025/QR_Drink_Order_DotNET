@page "/admin/auditlogs"
@attribute [Authorize(Roles = "Admin,Manager")]
@inject QRDrinkOrder.Client.Services.ApiClients.AuditLogApiClient AuditLogApi

@layout QRDrinkOrder.Client.Layout.AdminLayout

<PageTitle>Nhật ký hệ thống - Ngoc UwU Coffee</PageTitle>

<div>
    <div class="admin-topbar">
        <div class="admin-topbar-left">
            <h1 class="admin-page-title">Nhật ký Hệ thống (Audit Logs)</h1>
            <p class="admin-page-subtitle">Theo dõi các hoạt động thay đổi dữ liệu của tài khoản</p>
        </div>
        <div class="admin-topbar-right">
            <div class="dash-custom-date-row">
                <input type="date" class="dash-date-input" @bind="startDate" />
                <span class="dash-date-sep">—</span>
                <input type="date" class="dash-date-input" @bind="endDate" />
                <button class="dash-apply-btn" @onclick="() => LoadData(1)">Lọc ngày</button>
            </div>
        </div>
    </div>

    @if (!hasLoaded)
    {
        <!-- Màn hình chờ lazy load -->
        <div class="admin-table-card" style="text-align: center; padding: 4rem 2rem;">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: #ccc; margin-bottom: 1rem;">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            <p class="text-secondary">Chọn khoảng ngày và nhấn <strong>Lọc ngày</strong> để tải nhật ký hệ thống.</p>
        </div>
    }
    else if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <div class="mt-2 text-secondary">Đang tải dữ liệu...</div>
        </div>
    }
    else
    {
        <!-- Thanh tìm kiếm -->
        <div class="card border-0 shadow-sm mb-4 p-3 rounded-3" style="background-color: #ffffff;">
            <div class="row g-3 align-items-center">
                <div class="col-md-8">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        </span>
                        <input type="text" class="form-control border-start-0 ps-0"
                               placeholder="Tìm theo tên, email, hành động, bảng, mô tả..."
                               value="@searchQuery"
                               @oninput="OnSearchInput" />
                    </div>
                </div>
                <div class="col-md-4 d-flex justify-content-md-end align-items-center gap-2">
                    <span class="small text-muted fw-bold">Tổng @totalCount bản ghi</span>
                </div>
            </div>
        </div>

        <div class="admin-table-card">
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th style="width: 15%">Thời gian</th>
                            <th style="width: 25%">Người thực hiện</th>
                            <th style="width: 15%">Hành động</th>
                            <th style="width: 20%">Bảng / Chức năng</th>
                            <th style="width: 25%">Mô tả</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (filteredLogs.Any())
                        {
                            @foreach (var log in filteredLogs)
                            {
                                <tr>
                                    <td class="py-3 text-secondary small">
                                        @(log.CreatedAt?.ToString("dd/MM/yyyy HH:mm:ss") ?? "-")
                                    </td>
                                    <td class="py-3">
                                        <div class="fw-bold">@(log.FullName ?? "Hệ thống")</div>
                                        <div class="small text-secondary">@(log.Email ?? "")</div>
                                    </td>
                                    <td class="py-3">
                                        @if (log.Action == "INSERT")
                                        {
                                            <span class="admin-badge badge-success">Thêm mới</span>
                                        }
                                        else if (log.Action == "UPDATE")
                                        {
                                            <span class="admin-badge badge-warning">Cập nhật</span>
                                        }
                                        else if (log.Action == "DELETE")
                                        {
                                            <span class="admin-badge badge-danger">Xóa</span>
                                        }
                                        else
                                        {
                                            <span class="admin-badge badge-secondary">@log.Action</span>
                                        }
                                    </td>
                                    <td class="py-3">
                                        <span class="admin-badge" style="background: rgba(var(--bs-primary-rgb), 0.1); color: var(--bs-primary)">
                                            @(log.TableName ?? "-")
                                        </span>
                                    </td>
                                    <td class="py-3 text-secondary small" style="word-break: break-word; max-width: 300px;">
                                        @(string.IsNullOrEmpty(log.Description) ? $"ID Tài khoản: {log.AccountId?.ToString() ?? "N/A"}" : log.Description)
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-secondary">Không có nhật ký nào phù hợp.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Premium Pagination -->
            <div class="admin-paginator">
                <span class="admin-paginator-info">Tổng số: <strong>@totalCount</strong> bản ghi | Trang <strong>@currentPage</strong></span>
                <div class="admin-paginator-controls">
                    <button class="admin-page-btn" disabled="@(currentPage == 1)" @onclick="() => LoadData(currentPage - 1)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
                    </button>
                    <button class="admin-page-btn active">@currentPage</button>
                    <button class="admin-page-btn" disabled="@(logs.Count < pageSize)" @onclick="() => LoadData(currentPage + 1)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool hasLoaded = false;
    private bool isLoading = false;
    private List<QRDrinkOrder.Shared.DTOs.Responses.AuditLogDto> logs = new();
    private List<QRDrinkOrder.Shared.DTOs.Responses.AuditLogDto> filteredLogs = new();

    private int currentPage = 1;
    private int pageSize = 20;
    private int totalCount = 0;

    private DateTime? startDate = DateTime.Today.AddDays(-7);
    private DateTime? endDate = DateTime.Today;
    private string searchQuery = "";

    private async Task LoadData(int page)
    {
        isLoading = true;
        hasLoaded = true;
        currentPage = page;
        StateHasChanged();

        try
        {
            var response = await AuditLogApi.GetAuditLogsAsync(currentPage, pageSize, startDate, endDate, null);
            if (response != null)
            {
                logs = response.Items;
                totalCount = response.TotalCount;
            }
            ApplySearchFilter();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading audit logs: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        ApplySearchFilter();
    }

    private void ApplySearchFilter()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            filteredLogs = logs;
            return;
        }

        var q = searchQuery.ToLower();
        filteredLogs = logs.Where(l =>
            (l.FullName != null && l.FullName.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
            (l.Email != null && l.Email.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
            (l.Action != null && l.Action.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
            (l.TableName != null && l.TableName.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
            (l.Description != null && l.Description.Contains(q, StringComparison.OrdinalIgnoreCase))
        ).ToList();
    }
}
