@page "/cart"
@inject QRDrinkOrder.Client.Services.State.CartState CartState
@inject QRDrinkOrder.Client.Services.State.OrderStateService OrderState
@inject QRDrinkOrder.Client.Services.ApiClients.OrderApiClient OrderApi
@inject QRDrinkOrder.Client.Services.ApiClients.CouponApiClient CouponApi
@inject QRDrinkOrder.Client.Services.ApiClients.MembershipApiClient MembershipApi
@inject QRDrinkOrder.Client.Services.PushNotificationService PushService
@inject QRDrinkOrder.Client.Services.CustomerAuthService CustomerAuth
@using QRDrinkOrder.Shared.DTOs.Requests
@using QRDrinkOrder.Shared.Enums
@using QRDrinkOrder.Client.Services
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> Loc
@inject ILogger<Cart> Logger

<PageTitle>@Loc["ConfirmOrderTitle"] - Ngoc UwU Coffee</PageTitle>

<div class="mb-3 d-flex align-items-center bg-white p-3 border-bottom sticky-top" style="margin: -1rem -1rem 1rem -1rem; z-index: 10;">
    <a href="/" class="text-decoration-none text-dark me-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
    </a>
    <span class="fw-bold fs-5 mb-0 mx-auto" style="transform: translateX(-12px);">@Loc["ConfirmOrderTitle"]</span>
</div>

@if (!CartState.Items.Any())
{
    <div class="text-center py-5 bg-white rounded" style="border: 1px solid #f0f0f0;">
        <img src="/images/placeholder.png" alt="Empty Cart" style="width: 150px; opacity: 0.8;" class="mb-3" onerror="this.onerror=null; this.src='/images/placeholder.png';" />
        <h6 class="fw-bold">@Loc["EmptyCartTitle"]</h6>
        <p class="text-muted small">@Loc["EmptyCartSub"]</p>
        <a href="/" class="btn btn-primary mt-3 px-4">@Loc["ContinueShoppingBtn"]</a>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-7 mb-4">
            <!-- Khối thông tin nhận hàng -->
            <div class="tch-card p-3 mb-3">
                <h6 class="fw-bold mb-3">@Loc["DeliveryOptionsTitle"]</h6>
                
                <div class="d-flex gap-2 mb-3">
                    <button class="btn @(orderType == OrderType.Pickup ? "btn-outline-primary active" : "btn-outline-secondary") flex-fill fw-bold rounded-pill" @onclick="() => orderType = OrderType.Pickup">@Loc["TakeawayBtn"]</button>
                    <button class="btn @(orderType == OrderType.DineIn ? "btn-outline-primary active" : "btn-outline-secondary") flex-fill fw-bold rounded-pill" @onclick="() => orderType = OrderType.DineIn">@Loc["DineInBtn"]</button>
                </div>

                @if (orderType == OrderType.DineIn)
                {
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">@Loc["TableNumberLabel"] <span class="text-danger">*</span></label>
                        <input type="text" class="form-control bg-light border-0" @bind="tableNumber" placeholder="Bàn / Table (VD: Bàn 12)" />
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label fw-bold small text-secondary">@Loc["PhoneLabel"] <span class="text-danger">*</span></label>
                    <input type="tel" maxlength="10" inputmode="numeric" class="form-control bg-light border-0" value="@phone" @oninput="OnPhoneInput" placeholder="09xxxxxxx (nhập đủ 10 số để xác thực PIN)" />
                </div>
                
                @if (membership != null)
                {
                    if (membership.Points > 0)
                    {
                        <div class="bg-light p-3 rounded mb-3 border border-warning" style="background-color: #fff9e6 !important;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div>
                                    <h6 class="fw-bold mb-0 text-warning d-flex align-items-center">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-star-fill me-1" viewBox="0 0 16 16">
                                          <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"/>
                                        </svg>
                                        @Loc["RewardPointsTitle"]
                                    </h6>
                                    <small class="text-muted">Bạn có <strong>@membership.Points</strong> điểm</small>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="usePointsSwitch" checked="@usePoints" @onclick="TogglePoints">
                                    <label class="form-check-label small fw-bold" for="usePointsSwitch">@Loc["UsePointsLabel"]</label>
                                </div>
                            </div>
                            
                            @if (usePoints)
                            {
                                <div class="d-flex align-items-center mt-2 gap-2">
                                    <input type="number" class="form-control form-control-sm" style="width: 80px;" @bind="pointsToUse" @bind:event="oninput" min="1" max="@membership.Points" />
                                    <span class="small text-secondary">điểm để giảm <strong>@((pointsToUse * 1000).ToString("N0"))đ</strong></span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="bg-light p-2 rounded mb-3 text-secondary small d-flex align-items-center border" style="border-radius: 8px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-star me-2 text-warning" viewBox="0 0 16 16">
                              <path d="M2.866 14.85c-.078.444.36.791.746.593l4.39-2.256 4.389 2.256c.386.198.824-.149.746-.592l-.83-4.73 3.522-3.356c.33-.314.16-.888-.282-.95l-4.898-.696L8.465.792a.513.513 0 0 0-.927 0L5.354 5.12l-4.898.696c-.441.062-.612.636-.283.95l3.523 3.356-.83 4.73zm4.905-2.767-3.686 1.894.694-3.957a.565.565 0 0 0-.163-.505L1.71 6.745l4.052-.576a.525.525 0 0 0 .393-.288L8 2.223l1.847 3.658a.525.525 0 0 0 .393.288l4.052.575-2.906 2.77a.565.565 0 0 0-.163.506l.694 3.957-3.686-1.894a.503.503 0 0 0-.461 0z"/>
                            </svg>
                            <span>@Loc["RewardPointsTitle"]: <strong>0 điểm</strong> (Sẽ tự động tích điểm sau khi hoàn tất đơn hàng này)</span>
                        </div>
                    }
                }
                
                @if (isEmployee)
                {
                    <div class="bg-light p-3 rounded mb-3 border border-primary" style="background-color: #e6f0ff !important;">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <h6 class="fw-bold mb-0 text-primary d-flex align-items-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-badge me-1" viewBox="0 0 16 16">
                                      <path d="M6.5 2a.5.5 0 0 0 0 1h3a.5.5 0 0 0 0-1h-3zM11 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                                      <path d="M4.5 0A2.5 2.5 0 0 0 2 2.5V14a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2.5A2.5 2.5 0 0 0 11.5 0h-7zM3 2.5A1.5 1.5 0 0 1 4.5 1h7A1.5 1.5 0 0 1 13 2.5v10.795a4.224 4.224 0 0 0-.776-.492C11.392 12.387 10.063 12 8 12s-3.392.387-4.224.803a4.224 4.224 0 0 0-.776.492V2.5z"/>
                                    </svg>
                                    @Loc["EmployeeBenefitTitle"]
                                </h6>
                                <small class="text-muted">Giảm 50% cho đơn hàng này</small>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="useEmployeeBenefitSwitch" @bind="useEmployeeBenefit" disabled="@(appliedCoupon != null)">
                                <label class="form-check-label small fw-bold" for="useEmployeeBenefitSwitch">Sử dụng</label>
                            </div>
                        </div>
                        @if (appliedCoupon != null)
                        {
                            <div class="small text-danger mt-1">Không thể dùng chung với mã giảm giá khác.</div>
                        }
                    </div>
                }
                
                <div class="mb-2">
                    <label class="form-label fw-bold small text-secondary">@Loc["NoteLabel"]</label>
                    <input type="text" class="form-control bg-light border-0" @bind="orderNote" placeholder="Ghi chú / Note" />
                </div>
            </div>

            <!-- Khối danh sách món -->
            <div class="tch-card p-3 mb-3">
                <h6 class="fw-bold mb-3">@Loc["SelectedItemsTitle"]</h6>
                @foreach (var item in CartState.Items)
                {
                    <div class="d-flex mb-3 align-items-center">
                        <button class="btn btn-link text-secondary p-0 me-3" @onclick="() => CartState.RemoveItem(item)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-circle" viewBox="0 0 16 16">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                                <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
                            </svg>
                        </button>
                        <div class="fw-bold me-2">x @item.Quantity</div>
                        <img src="@(string.IsNullOrEmpty(item.Drink.ImageUrl) ? "/images/placeholder.png" : item.Drink.ImageUrl)" class="rounded" style="width: 45px; height: 45px; object-fit: cover;" />
                        <div class="ms-3 flex-grow-1">
                            <div class="fw-bold" style="font-size: 0.95rem;">@item.Drink.DrinkName</div>
                            <div class="small text-secondary">
                                @if (item.Drink.TemperatureType != QRDrinkOrder.Shared.Enums.DrinkTemperature.Other &&
                                     !(item.Drink.CategoryName?.Contains("Bánh", StringComparison.OrdinalIgnoreCase) ?? false) &&
                                     !(item.Drink.CategoryName?.Contains("Khác", StringComparison.OrdinalIgnoreCase) ?? false) &&
                                     !(item.Drink.CategoryName?.Contains("Cake", StringComparison.OrdinalIgnoreCase) ?? false) &&
                                     !(item.Drink.CategoryName?.Contains("Other", StringComparison.OrdinalIgnoreCase) ?? false))
                                {
                                    <span>Đá: @item.IceLevel%, Đường: @item.SweetnessLevel%</span>
                                    @if (item.SelectedSize != null)
                                    {
                                        <span> | Size: @item.SelectedSize.Name</span>
                                    }
                                }
                                else if (item.SelectedSize != null)
                                {
                                    <span>Size: @item.SelectedSize.Name</span>
                                }
                            </div>
                            @if (item.SelectedToppings.Any() &&
                                 item.Drink.TemperatureType != QRDrinkOrder.Shared.Enums.DrinkTemperature.Other &&
                                 !(item.Drink.CategoryName?.Contains("Bánh", StringComparison.OrdinalIgnoreCase) ?? false) &&
                                 !(item.Drink.CategoryName?.Contains("Khác", StringComparison.OrdinalIgnoreCase) ?? false))
                            {
                                <div class="small text-secondary">
                                    Topping: @string.Join(", ", item.SelectedToppings.Select(t => t.Name))
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(item.ItemNote))
                            {
                                <div class="small text-secondary">Ghi chú: @item.ItemNote</div>
                            }
                        </div>
                        <div class="fw-bold text-end">@item.TotalPrice.ToString("N0")đ</div>
                    </div>
                }
            </div>
        </div>

        <div class="col-md-5">
            <!-- Tóm tắt hóa đơn & Khuyến mãi -->
            <div class="tch-card p-3 mb-3">
                <h6 class="fw-bold mb-3 border-bottom pb-2">@Loc["TotalTitle"]</h6>
                
                <div class="mb-3 d-flex align-items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="var(--tch-orange)" class="bi bi-ticket-perforated flex-shrink-0" viewBox="0 0 16 16">
                        <path d="M4 4.85v.9h1v-.9H4Zm7 0v.9h1v-.9h-1Zm-7 1.8v.9h1v-.9H4Zm7 0v.9h1v-.9h-1Zm-7 1.8v.9h1v-.9H4Zm7 0v.9h1v-.9h-1Zm-7 1.8v.9h1v-.9H4Zm7 0v.9h1v-.9h-1Z"/>
                        <path d="M1.5 3A1.5 1.5 0 0 0 0 4.5V6a.5.5 0 0 0 .5.5 1.5 1.5 0 1 1 0 3 .5.5 0 0 0-.5.5v1.5A1.5 1.5 0 0 0 1.5 13h13a1.5 1.5 0 0 0 1.5-1.5V10a.5.5 0 0 0-.5-.5 1.5 1.5 0 0 1 0-3A.5.5 0 0 0 16 6V4.5A1.5 1.5 0 0 0 14.5 3h-13ZM1 4.5a.5.5 0 0 1 .5-.5h13a.5.5 0 0 1 .5.5v1.05a2.5 2.5 0 0 0 0 4.9v1.05a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5v-1.05a2.5 2.5 0 0 0 0-4.9V4.5Z"/>
                    </svg>
                    <input type="text" class="form-control text-uppercase" style="border: 1px dashed var(--tch-orange);" @bind="couponCode" placeholder="Mã giảm giá (nếu có)" disabled="@(appliedCoupon != null)" />
                    @if (appliedCoupon == null)
                    {
                        <button class="btn btn-outline-primary px-3" @onclick="ApplyCoupon" disabled="@isApplyingCoupon">
                            @if (isApplyingCoupon) { <span class="spinner-border spinner-border-sm"></span> }
                            else { <span>@Loc["ApplyBtn"]</span> }
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-outline-danger px-3" @onclick="RemoveCoupon">@Loc["RemoveBtn"]</button>
                    }
                </div>
                @if (availableCoupons.Any() && appliedCoupon == null)
                {
                    <div class="mb-3">
                        <div class="small fw-bold text-secondary mb-1">Áp dụng ngay mã ưu đãi:</div>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var c in availableCoupons)
                            {
                                var eff = c.GetEffectiveDiscount();
                                <span class="badge bg-light text-dark border border-warning p-2 me-1 mb-1 shadow-sm" 
                                      style="cursor: pointer; border-radius: 8px; transition: all 0.2s;"
                                      @onclick="() => SelectCoupon(c.CouponCode)">
                                    <strong class="text-danger">🏷️ @c.CouponCode</strong> 
                                    <span class="small text-muted ms-1">(@(eff.EffectiveType == 0 ? $"Giảm {eff.EffectiveValue.ToString("N0")}đ" : $"Giảm {eff.EffectiveValue.ToString("0.##")}%"))</span>
                                </span>
                            }
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(couponMessage))
                {
                    <div class="small fw-bold mb-3 text-@(appliedCoupon != null ? "success" : "danger")">@couponMessage</div>
                }

                @if (appliedCoupon != null)
                {
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary small">@Loc["SubtotalLabel"]</span>
                        <span class="text-secondary small text-decoration-line-through">@CartState.GetTotalAmount().ToString("N0")đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-success small fw-bold">@Loc["DiscountLabel"]</span>
                        <span class="text-success fw-bold">-@discountAmount.ToString("N0")đ</span>
                    </div>
                }
                
                @if (usePoints && pointsToUse > 0)
                {
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-warning small fw-bold">@Loc["UsePointsLabel"] (@pointsToUse điểm)</span>
                        <span class="text-warning fw-bold">-@((pointsToUse * 1000).ToString("N0"))đ</span>
                    </div>
                }
                
                @if (isEmployee && useEmployeeBenefit && appliedCoupon == null)
                {
                    var employeeDiscount = (CartState.GetTotalAmount() - discountAmount - (usePoints ? pointsToUse * 1000 : 0)) * 0.5m;
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-primary small fw-bold">@Loc["EmployeeBenefitTitle"] (-50%)</span>
                        <span class="text-primary fw-bold">-@employeeDiscount.ToString("N0")đ</span>
                    </div>
                }
                
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-secondary fw-bold">@Loc["FinalAmountLabel"]</span>
                    <span class="fw-bold fs-5" style="color: var(--tch-orange);">@GetFinalAmount().ToString("N0")đ</span>
                </div>
            </div>

            <!-- Phương thức thanh toán -->
            <div class="tch-card p-3 mb-4">
                <h6 class="fw-bold mb-3">@Loc["PaymentMethodTitle"]</h6>
                <div class="form-check mb-3 d-flex align-items-center" @onclick="() => paymentMethod = (byte)PaymentMethod.SePay" style="cursor: pointer;">
                    <input class="form-check-input me-2" type="radio" name="paymentMethod" checked="@(paymentMethod == (byte)PaymentMethod.SePay)">
                    <label class="form-check-label d-flex align-items-center flex-grow-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-qr-code-scan me-2 text-primary" viewBox="0 0 16 16">
                            <path d="M0 .5A.5.5 0 0 1 .5 0h3a.5.5 0 0 1 0 1H1v2.5a.5.5 0 0 1-1 0v-3Zm12 0a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-1 0V1h-2.5a.5.5 0 0 1-.5-.5ZM0 12a.5.5 0 0 1 .5-.5H1V9a.5.5 0 0 1 1 0v2.5h2.5a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5Zm15.5-.5a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1 0-1H15V12a.5.5 0 0 1 .5-.5ZM2 4h4v4H2V4Zm5 0h2v1H7V4Zm3 0h2v1h-2V4ZM7 6h1v2H7V6Zm2 0h1v1H9V6Zm2 0h1v2h-1V6ZM7 9h2v1H7V9Zm3 0h1v1h-1V9ZM2 10h4v4H2v-4Zm7 1h1v1H9v-1Zm2 0h1v2h-1v-2Zm-2 2h1v1H9v-1Z"/>
                        </svg>
                        @Loc["QRBankTransfer"]
                    </label>
                </div>
                <div class="form-check d-flex align-items-center" @onclick="() => paymentMethod = (byte)PaymentMethod.Cash" style="cursor: pointer;">
                    <input class="form-check-input me-2" type="radio" name="paymentMethod" checked="@(paymentMethod == (byte)PaymentMethod.Cash)">
                    <label class="form-check-label d-flex align-items-center flex-grow-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-cash me-2 text-success" viewBox="0 0 16 16">
                            <path d="M8 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/>
                            <path d="M0 4a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V4zm3 0a2 2 0 0 1-2 2v4a2 2 0 0 1 2 2h10a2 2 0 0 1 2-2V6a2 2 0 0 1-2-2H3z"/>
                        </svg>
                        @Loc["CashPayment"]
                    </label>
                </div>
            </div>

            <!-- Fix to bottom button on mobile, sticky on PC -->
            <div class="glass-panel p-3 sticky-bottom mt-3" style="margin: 0 -1rem; z-index: 100; border-top-left-radius: var(--tch-radius-md); border-top-right-radius: var(--tch-radius-md);">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger small py-2 mb-2">@errorMessage</div>
                }
                
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div>
                        <div class="text-secondary small fw-bold">@Loc["FinalAmountLabel"]</div>
                        <div class="fw-bold fs-5" style="color: var(--tch-orange);">@GetFinalAmount().ToString("N0")đ</div>
                    </div>
                    <button class="btn btn-primary px-5 py-3 fw-bold" style="border-radius: 24px;" @onclick="SubmitOrder" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span> <span>@Loc["OrderingText"]</span>
                        }
                        else
                        {
                            <span>@Loc["PlaceOrderBtn"]</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<CustomerPinModal @bind-IsOpen="showPinModal"
                  PhoneNumber="@phone"
                  Mode="@pinModalMode"
                  OnPinVerified="HandlePinVerified" />

@code {
    private string phone = "";
    private string couponCode = "";
    private string orderNote = "";
    private byte paymentMethod = (byte)PaymentMethod.SePay;
    
    private bool showPinModal = false;
    private CustomerPinModal.PinModalMode pinModalMode = CustomerPinModal.PinModalMode.Verify;
    private bool pendingOrderSubmit = false;
    private bool pendingPointsToggle = false;
    private string verifiedAuthToken = "";
    
    private bool isSubmitting = false;
    private string errorMessage = "";
    
    private OrderType orderType = OrderType.Pickup;
    private string tableNumber = "";
    
    private CouponDto? appliedCoupon = null;
    private List<CouponDto> availableCoupons = new();
    private decimal discountAmount = 0;
    private string couponMessage = "";
    private bool isApplyingCoupon = false;
    
    private MembershipDto? membership;
    private MembershipDto? pendingMembership;
    private string lastCheckedPhone = "";
    private bool usePoints = false;
    private int pointsToUse = 0;
    
    private bool isEmployee = false;
    private bool useEmployeeBenefit = false;

    protected override async Task OnInitializedAsync()
    {
        CartState.OnChange += StateHasChanged;
        orderType = OrderState.CurrentOrderType;
        tableNumber = OrderState.TableNumber ?? "";
        
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true && authState.User.IsInRole("Employee"))
        {
            isEmployee = true;
        }

        // Tự động khôi phục SĐT từ Session đăng nhập PIN nếu có
        try
        {
            await CustomerAuth.InitializeAsync();
            if (CustomerAuth.IsAuthenticated && !string.IsNullOrEmpty(CustomerAuth.CurrentPhone))
            {
                phone = CustomerAuth.CurrentPhone;
                await CheckMembership();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Lỗi khi khôi phục thông tin đăng nhập khách hàng");
        }

        // Tải danh sách mã giảm giá khả dụng
        try
        {
            availableCoupons = await CouponApi.GetAvailableCouponsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Không thể tải danh sách mã giảm giá khả dụng");
        }
    }
    
    private decimal GetFinalAmount()
    {
        var total = CartState.GetTotalAmount();
        decimal pointDiscount = usePoints ? pointsToUse * 1000 : 0;
        
        var final = total - discountAmount - pointDiscount;
        if (isEmployee && useEmployeeBenefit && appliedCoupon == null)
        {
            final = final * 0.5m;
        }
        
        return final > 0 ? final : 0;
    }
    
    private async Task OnPhoneInput(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        var digits = new string(val.Where(char.IsDigit).ToArray());
        if (digits.Length > 10) digits = digits.Substring(0, 10);
        phone = digits;
        await CheckMembership();
    }

    private async Task CheckMembership()
    {
        if (!string.IsNullOrWhiteSpace(phone))
        {
            var cleanPhone = phone.Trim();
            
            bool isCompletePhone = (cleanPhone.Length == 10 && cleanPhone.StartsWith("0")) 
                                || (cleanPhone.Length == 9 && !cleanPhone.StartsWith("0") && !cleanPhone.StartsWith("+"))
                                || (cleanPhone.Length >= 11 && cleanPhone.StartsWith("+"));

            if (isCompletePhone && cleanPhone != lastCheckedPhone)
            {
                lastCheckedPhone = cleanPhone;
                var savedToken = await CustomerAuth.GetAuthTokenAsync();
                var isSavedTokenValid = !string.IsNullOrEmpty(savedToken) && CustomerAuth.CurrentPhone == cleanPhone;

                var result = await MembershipApi.GetMembershipByPhoneAsync(cleanPhone);
                
                if (isSavedTokenValid)
                {
                    membership = result;
                    verifiedAuthToken = savedToken;
                    if (membership != null && pointsToUse > membership.Points)
                    {
                        pointsToUse = membership.Points;
                    }
                }
                else
                {
                    // Yêu cầu xác thực/thiết lập PIN ngay sau khi nhập đủ số điện thoại vào ô!
                    pendingMembership = result ?? new MembershipDto { Phone = cleanPhone, Points = 0, IsPinSet = false };
                    pinModalMode = (result != null && result.IsPinSet) ? CustomerPinModal.PinModalMode.Verify : CustomerPinModal.PinModalMode.SetupStep1;
                    showPinModal = true;
                }
                StateHasChanged();
            }
            else if (cleanPhone != lastCheckedPhone && cleanPhone.Length < 9)
            {
                membership = null;
                verifiedAuthToken = null;
                usePoints = false;
                pointsToUse = 0;
                lastCheckedPhone = "";
                StateHasChanged();
            }
        }
        else if (membership != null || !string.IsNullOrEmpty(lastCheckedPhone))
        {
            membership = null;
            pendingMembership = null;
            verifiedAuthToken = null;
            usePoints = false;
            pointsToUse = 0;
            lastCheckedPhone = "";
            StateHasChanged();
        }
    }
    
    private async Task TogglePoints()
    {
        if (!usePoints)
        {
            if (membership == null) return;
            var cleanPhone = phone.Trim();
            var savedToken = await CustomerAuth.GetAuthTokenAsync();
            var isSavedTokenValid = !string.IsNullOrEmpty(savedToken) && CustomerAuth.CurrentPhone == cleanPhone;

            if (!string.IsNullOrEmpty(verifiedAuthToken) || isSavedTokenValid)
            {
                if (string.IsNullOrEmpty(verifiedAuthToken) && isSavedTokenValid)
                    verifiedAuthToken = savedToken;

                usePoints = true;
                pointsToUse = membership.Points;
            }
            else
            {
                pendingPointsToggle = true;
                pendingMembership = membership;
                pinModalMode = membership.IsPinSet ? CustomerPinModal.PinModalMode.Verify : CustomerPinModal.PinModalMode.SetupStep1;
                showPinModal = true;
            }
        }
        else
        {
            usePoints = false;
            pointsToUse = 0;
        }
        StateHasChanged();
    }
    
    private async Task ApplyCoupon()
    {
        if (string.IsNullOrWhiteSpace(couponCode)) return;
        
        if (string.IsNullOrWhiteSpace(phone))
        {
            couponMessage = "Vui lòng nhập số điện thoại trước khi áp dụng mã.";
            return;
        }

        isApplyingCoupon = true;
        couponMessage = "";
        try
        {
            var req = new ApplyCouponRequest
            {
                CouponCode = couponCode.ToUpper().Trim(),
                OrderAmount = CartState.GetTotalAmount(),
                Phone = phone
            };
            
            var result = await CouponApi.ApplyCouponAsync(req);
            if (result != null)
            {
                appliedCoupon = result;
                var eff = result.GetEffectiveDiscount();
                if (eff.EffectiveType == 0) // Fixed
                {
                    discountAmount = eff.EffectiveValue;
                }
                else // Percentage
                {
                    var calculated = CartState.GetTotalAmount() * (eff.EffectiveValue / 100m);
                    var maxCap = result.GetEffectiveMaxDiscount();
                    if (maxCap.HasValue && calculated > maxCap.Value)
                        calculated = maxCap.Value;
                    discountAmount = calculated;
                }
                couponMessage = $"Áp dụng thành công! Giảm {discountAmount.ToString("N0")}đ";
            }
            else
            {
                couponMessage = "Mã giảm giá không hợp lệ hoặc không đủ điều kiện.";
                appliedCoupon = null;
                discountAmount = 0;
            }
        }
        catch
        {
            couponMessage = "Mã không hợp lệ hoặc đã hết hạn.";
            appliedCoupon = null;
            discountAmount = 0;
        }
        finally
        {
            isApplyingCoupon = false;
        }
    }

    private async Task SelectCoupon(string code)
    {
        couponCode = code;
        await ApplyCoupon();
    }

    private void RemoveCoupon()
    {
        appliedCoupon = null;
        discountAmount = 0;
        couponCode = "";
        couponMessage = "";
    }

    private async Task SubmitOrder()
    {
        if (string.IsNullOrWhiteSpace(phone))
        {
            errorMessage = "Vui lòng nhập số điện thoại của bạn.";
            return;
        }

        if (orderType == OrderType.DineIn && string.IsNullOrWhiteSpace(tableNumber))
        {
            errorMessage = "Vui lòng nhập số bàn của bạn.";
            return;
        }

        if (paymentMethod == (byte)PaymentMethod.SePay && GetFinalAmount() < 2000)
        {
            errorMessage = "Số tiền thanh toán qua Chuyển khoản tối thiểu phải từ 2.000đ trở lên. Vui lòng chọn phương thức Tiền mặt hoặc giảm bớt ưu đãi.";
            return;
        }

        if (usePoints && pointsToUse > 0)
        {
            if (string.IsNullOrEmpty(verifiedAuthToken))
            {
                var savedToken = await CustomerAuth.GetAuthTokenAsync();
                if (!string.IsNullOrEmpty(savedToken) && CustomerAuth.CurrentPhone == phone.Trim())
                {
                    verifiedAuthToken = savedToken;
                }
                else
                {
                    pendingOrderSubmit = true;
                    if (membership != null && membership.IsPinSet)
                        pinModalMode = CustomerPinModal.PinModalMode.Verify;
                    else
                        pinModalMode = CustomerPinModal.PinModalMode.SetupStep1;

                    showPinModal = true;
                    return;
                }
            }
        }

        try
        {
            isSubmitting = true;
            errorMessage = "";

            var tableStr = orderType == OrderType.DineIn ? $"Bàn {tableNumber.Replace("Bàn", "").Replace("bàn", "").Trim()}" : "Mang đi";

            var request = new CreateOrderRequest
            {
                Phone = phone.Trim(),
                TableNumber = tableStr,
                CouponCode = appliedCoupon != null ? appliedCoupon.CouponCode : (string.IsNullOrWhiteSpace(couponCode) ? null : couponCode.ToUpper().Trim()),
                PointsToUse = usePoints && pointsToUse > 0 ? pointsToUse : null,
                CustomerAuthToken = usePoints && pointsToUse > 0 ? (!string.IsNullOrEmpty(verifiedAuthToken) ? verifiedAuthToken : await CustomerAuth.GetAuthTokenAsync()) : null,
                PaymentMethod = paymentMethod,
                Note = orderNote,
                Items = CartState.Items.Select(i => new OrderItemRequest
                {
                    DrinkId = i.Drink.DrinkId,
                    Quantity = i.Quantity,
                    SweetnessLevel = i.SweetnessLevel,
                    IceLevel = i.IceLevel,
                    ItemNote = i.ItemNote,
                    UnitPrice = i.UnitPrice,
                    SizeId = i.SelectedSize?.SizeId,
                    ToppingIds = i.SelectedToppings.Select(t => t.ToppingId).ToList()
                }).ToList(),
                UseEmployeeBenefit = useEmployeeBenefit
            };

            var result = await OrderApi.CreateOrderAsync(CartState.SessionId, request);
            
            if (result != null)
            {
                CartState.ClearCart();
                
                if (result.Payment != null && result.Payment.PaymentMethod == (byte)PaymentMethod.SePay)
                {
                    NavigationManager.NavigateTo($"/payment/{result.OrderId}");
                }
                else
                {
                    NavigationManager.NavigateTo($"/track-order/{result.OrderId}");
                }

                // Hỏi quyền thông báo đẩy (Background task)
                _ = PushService.SubscribeToNotificationsAsync(phone);
            }
            else
            {
                errorMessage = "Có lỗi xảy ra khi tạo đơn hàng. Vui lòng thử lại.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task HandlePinVerified(string token)
    {
        showPinModal = false;
        if (!string.IsNullOrEmpty(token))
        {
            verifiedAuthToken = token;
            if (pendingMembership != null)
            {
                membership = pendingMembership;
                membership.IsPinSet = true;
            }
            else if (membership == null)
            {
                membership = await MembershipApi.GetMembershipByPhoneAsync(phone.Trim());
            }

            if (pendingPointsToggle && membership != null)
            {
                pendingPointsToggle = false;
                usePoints = true;
                pointsToUse = membership.Points;
            }
            if (pendingOrderSubmit)
            {
                pendingOrderSubmit = false;
                await SubmitOrder();
            }
        }
        else
        {
            pendingPointsToggle = false;
            pendingOrderSubmit = false;
            usePoints = false;
            pointsToUse = 0;
            if (CustomerAuth.CurrentPhone != phone.Trim())
            {
                membership = null;
                verifiedAuthToken = null;
                lastCheckedPhone = "";
            }
        }
        StateHasChanged();
    }

    private async Task ClearPinSession()
    {
        await CustomerAuth.LogoutAsync();
        verifiedAuthToken = null;
        membership = null;
        pendingMembership = null;
        lastCheckedPhone = "";
        usePoints = false;
        pointsToUse = 0;
        phone = "";
        StateHasChanged();
    }
}

