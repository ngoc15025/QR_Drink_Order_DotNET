@page "/pos"
@attribute [Authorize(Roles = "Bartender,Waiter")]
@inject NavigationManager NavigationManager
@inject QRDrinkOrder.Client.Services.ApiClients.OrderApiClient OrderApi
@inject QRDrinkOrder.Client.Services.ApiClients.SystemConfigApiClient ConfigApi
@inject QRDrinkOrder.Client.Services.ApiClients.MenuApiClient MenuApi
@inject IJSRuntime JSRuntime
@using QRDrinkOrder.Shared.DTOs.Responses
@using Microsoft.AspNetCore.SignalR.Client
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject ILogger<EmployeeDashboard> Logger
@inject QRDrinkOrder.Client.Services.LocalStorageService LocalStorage
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@implements IAsyncDisposable

<PageTitle>POS - Ngoc UwU Coffee</PageTitle>

<div class="pos-wrapper">
    <!-- POS Header -->
    <header class="pos-header">
        <div class="pos-header-left">
            <div class="pos-logo-mark">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M18 8h1a4 4 0 0 1 0 8h-1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <line x1="6" y1="1" x2="6" y2="4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <line x1="10" y1="1" x2="10" y2="4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <line x1="14" y1="1" x2="14" y2="4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </div>
            <div>
                <h1 class="pos-title">Màn hình POS</h1>
                <p class="pos-subtitle">Ngoc UwU Coffee · Quản lý đơn đặt</p>
            </div>
            <span class="pos-role-badge @(isWaiter ? "role-waiter" : "role-bartender")">
                @(isWaiter ? "Phục vụ" : "Pha chế")
            </span>
        </div>
        <div class="pos-header-right">
            <div class="pos-stats-pill">
                <span class="pos-stat-item">
                    <span class="pos-stat-dot dot-warning"></span>
                    <span>@PendingOrders.Count Chờ xử lý</span>
                </span>
                <div class="pos-stat-divider"></div>
                <span class="pos-stat-item">
                    <span class="pos-stat-dot dot-info"></span>
                    <span>@PaidOrders.Count Đã thanh toán</span>
                </span>
                <div class="pos-stat-divider"></div>
                <span class="pos-stat-item">
                    <span class="pos-stat-dot dot-info"></span>
                    <span>@PreparingOrders.Count Đang pha chế</span>
                </span>
                <div class="pos-stat-divider"></div>
                <span class="pos-stat-item">
                    <span class="pos-stat-dot dot-success"></span>
                    <span>@CompletedOrders.Count Hoàn thành</span>
                </span>
            </div>
            @if (!isWaiter)
            {
                <button class="pos-menu-toggle-btn" @onclick="OpenMenuStatusModal" title="Quản lý tình trạng món">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/>
                        <line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/>
                    </svg>
                    Trạng thái món
                </button>
            }
            <button class="pos-exit-btn" @onclick="GoBack">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
                Thoát POS
            </button>
        </div>
    </header>

    <!-- Kanban Board -->
    @if (isLoading)
    {
        <div class="pos-loading">
            <div class="pos-loading-spinner"></div>
            <p>Đang tải đơn hàng...</p>
        </div>
    }
    else
    {
        <div class="kanban-board">
            <!-- Column: Chờ xử lý -->
            <div id="mob-pending" class="kanban-column col-pending @(expandedMobileColumn == "pending" ? "is-expanded" : "")">
                <div class="kanban-col-header" @onclick='() => ToggleMobileColumn("pending")'>
                    <div class="kanban-col-title-wrap">
                        <div class="kanban-col-icon icon-pending">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                            </svg>
                        </div>
                        <span class="kanban-col-title">Chờ xử lý</span>
                    </div>
                    <div class="kanban-header-right">
                        <span class="kanban-badge badge-pending">@PendingOrders.Count</span>
                        <svg class="accordion-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </div>
                </div>
                <div class="kanban-cards-wrapper">
                <div class="kanban-cards">
                    @if (!PendingOrders.Any())
                    {
                        <div class="kanban-empty">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                            </svg>
                            <p>Không có đơn chờ</p>
                        </div>
                    }
                    @foreach (var order in PendingOrders)
                    {
                        <div class="kanban-card card-pending">
                            <div class="kanban-card-header">
                                <div class="order-id">#ORD-@order.OrderId</div>
                                <div class="order-time">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                                    </svg>
                                    @order.OrderDate.ToString("HH:mm")
                                </div>
                            </div>
                            <div class="kanban-card-meta">
                                <div class="meta-item">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="3"/>
                                    </svg>
                                    @(string.IsNullOrEmpty(order.TableNumber) ? "Quầy" : "Bàn " + order.TableNumber)
                                </div>
                                <div class="meta-item">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/>
                                    </svg>
                                    @order.Payment?.PaymentMethodName
                                </div>
                            </div>
                            <div class="kanban-divider"></div>
                            <ul class="order-items-list">
                                @foreach (var item in order.Items)
                                {
                                    <li class="order-item">
                                        <div class="pos-item-header">
                                            <span class="pos-item-qty">@item.Quantity×</span>
                                            <span class="pos-item-name">@item.DrinkName</span>
                                        </div>
                                        <div class="pos-item-tags">
                                            @if (!string.IsNullOrEmpty(item.SizeName))
                                            {
                                                <span class="pos-tag pos-tag-size">Size: @item.SizeName</span>
                                            }
                                            <span class="pos-tag pos-tag-base">Đá: @item.IceLevel% · Đường: @item.SweetnessLevel%</span>
                                            @if (item.ToppingNames != null && item.ToppingNames.Any())
                                            {
                                                <span class="pos-tag pos-tag-topping">+ @string.Join(", ", item.ToppingNames)</span>
                                            }
                                            @if (!string.IsNullOrEmpty(item.ItemNote))
                                            {
                                                <span class="pos-tag pos-tag-note">Ghi chú: @item.ItemNote</span>
                                            }
                                        </div>
                                    </li>
                                }
                            </ul>
                            <div class="kanban-divider"></div>
                            <div class="kanban-card-footer">
                                <div class="order-total">@order.FinalAmount.ToString("N0")đ</div>
                                <div class="card-actions">
                                    @if (isWaiter)
                                    {
                                        @if (order.Payment != null && order.Payment.PaymentMethod == 0 && order.Payment.PaymentStatus == 0)
                                        {
                                            <button class="btn-kanban btn-accept" @onclick="() => ConfirmCashPayment(order.OrderId)">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                    <polyline points="20 6 9 17 4 12"/>
                                                </svg>
                                                Thu tiền
                                            </button>
                                        }
                                        <button class="btn-kanban btn-cancel" @onclick="() => CancelOrder(order.OrderId)" title="Hủy đơn">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                                            </svg>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            </div>

            <!-- Column: Đã thanh toán -->
            <div id="mob-paid" class="kanban-column col-paid @(expandedMobileColumn == "paid" ? "is-expanded" : "")">
                <div class="kanban-col-header" @onclick='() => ToggleMobileColumn("paid")'>
                    <div class="kanban-col-title-wrap">
                        <div class="kanban-col-icon icon-paid">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/>
                            </svg>
                        </div>
                        <span class="kanban-col-title">Đã thanh toán</span>
                    </div>
                    <div class="kanban-header-right">
                        <span class="kanban-badge badge-paid">@PaidOrders.Count</span>
                        <svg class="accordion-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </div>
                </div>
                <div class="kanban-cards-wrapper">
                <div class="kanban-cards">
                    @if (!PaidOrders.Any())
                    {
                        <div class="kanban-empty">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/>
                            </svg>
                            <p>Trống</p>
                        </div>
                    }
                    @foreach (var order in PaidOrders)
                    {
                        <div class="kanban-card card-paid">
                            <div class="kanban-card-header">
                                <div class="order-id">#ORD-@order.OrderId</div>
                                <div class="order-time">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                                    </svg>
                                    @order.OrderDate.ToString("HH:mm")
                                </div>
                            </div>
                            <div class="kanban-card-meta">
                                <div class="meta-item">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="3"/>
                                    </svg>
                                    @(string.IsNullOrEmpty(order.TableNumber) ? "Quầy" : "Bàn " + order.TableNumber)
                                </div>
                                <div class="meta-item text-success">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="20 6 9 17 4 12"/>
                                    </svg>
                                    Đã thanh toán
                                </div>
                            </div>
                            <div class="kanban-divider"></div>
                            <ul class="order-items-list">
                                @foreach (var item in order.Items)
                                {
                                    <li class="order-item">
                                        <div class="pos-item-header">
                                            <span class="pos-item-qty">@item.Quantity×</span>
                                            <span class="pos-item-name">@item.DrinkName</span>
                                        </div>
                                        <div class="pos-item-tags">
                                            @if (!string.IsNullOrEmpty(item.SizeName))
                                            {
                                                <span class="pos-tag pos-tag-size">Size: @item.SizeName</span>
                                            }
                                            <span class="pos-tag pos-tag-base">Đá: @item.IceLevel% · Đường: @item.SweetnessLevel%</span>
                                            @if (item.ToppingNames != null && item.ToppingNames.Any())
                                            {
                                                <span class="pos-tag pos-tag-topping">+ @string.Join(", ", item.ToppingNames)</span>
                                            }
                                            @if (!string.IsNullOrEmpty(item.ItemNote))
                                            {
                                                <span class="pos-tag pos-tag-note">Ghi chú: @item.ItemNote</span>
                                            }
                                        </div>
                                    </li>
                                }
                            </ul>
                            <div class="kanban-divider"></div>
                            <div class="kanban-card-footer">
                                <div class="order-total">@order.FinalAmount.ToString("N0")đ</div>
                                <div class="card-actions">
                                    @if (!isWaiter)
                                    {
                                        <button class="btn-kanban btn-accept" @onclick="() => UpdateOrderStatus(order.OrderId, 1)">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                <polyline points="20 6 9 17 4 12"/>
                                            </svg>
                                            Pha chế
                                        </button>
                                        <button class="btn-kanban btn-cancel" @onclick="() => CancelOrder(order.OrderId)" title="Hủy đơn">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                                            </svg>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            </div>

            <!-- Column: Đang pha chế -->
            <div id="mob-preparing" class="kanban-column col-preparing @(expandedMobileColumn == "preparing" ? "is-expanded" : "")">
                <div class="kanban-col-header" @onclick='() => ToggleMobileColumn("preparing")'>
                    <div class="kanban-col-title-wrap">
                        <div class="kanban-col-icon icon-preparing">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/>
                            </svg>
                        </div>
                        <span class="kanban-col-title">Đang pha chế</span>
                    </div>
                    <div class="kanban-header-right">
                        <span class="kanban-badge badge-preparing">@PreparingOrders.Count</span>
                        <svg class="accordion-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </div>
                </div>
                <div class="kanban-cards-wrapper">
                <div class="kanban-cards">
                    @if (!PreparingOrders.Any())
                    {
                        <div class="kanban-empty">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/>
                            </svg>
                            <p>Chưa có đơn đang làm</p>
                        </div>
                    }
                    @foreach (var order in PreparingOrders)
                    {
                        <div class="kanban-card card-preparing">
                            <div class="kanban-card-header">
                                <div class="order-id order-id-preparing">#ORD-@order.OrderId</div>
                                <div class="order-time">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                                    </svg>
                                    @order.OrderDate.ToString("HH:mm")
                                </div>
                            </div>
                            <div class="kanban-card-meta">
                                <div class="meta-item">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="3"/>
                                    </svg>
                                    @(string.IsNullOrEmpty(order.TableNumber) ? "Quầy" : "Bàn " + order.TableNumber)
                                </div>
                            </div>
                            <div class="kanban-divider"></div>
                            <ul class="order-items-list">
                                @foreach (var item in order.Items)
                                {
                                    <li class="order-item">
                                        <div class="pos-item-header">
                                            <span class="pos-item-qty">@item.Quantity×</span>
                                            <span class="pos-item-name">@item.DrinkName</span>
                                        </div>
                                        <div class="pos-item-tags">
                                            @if (!string.IsNullOrEmpty(item.SizeName))
                                            {
                                                <span class="pos-tag pos-tag-size">Size: @item.SizeName</span>
                                            }
                                            <span class="pos-tag pos-tag-base">Đá: @item.IceLevel% · Đường: @item.SweetnessLevel%</span>
                                            @if (item.ToppingNames != null && item.ToppingNames.Any())
                                            {
                                                <span class="pos-tag pos-tag-topping">+ @string.Join(", ", item.ToppingNames)</span>
                                            }
                                            @if (!string.IsNullOrEmpty(item.ItemNote))
                                            {
                                                <span class="pos-tag pos-tag-note">Ghi chú: @item.ItemNote</span>
                                            }
                                        </div>
                                    </li>
                                }
                            </ul>
                            <div class="kanban-divider"></div>
                            <div class="kanban-card-footer">
                                <div class="order-total order-total-preparing">@order.FinalAmount.ToString("N0")đ</div>
                                @if (!isWaiter)
                                {
                                    <button class="btn-kanban btn-complete" @onclick="() => UpdateOrderStatus(order.OrderId, 2)">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                            <polyline points="20 6 9 17 4 12"/>
                                        </svg>
                                        Hoàn thành
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
            </div>

            <!-- Column: Đã hoàn thành -->
            <div id="mob-completed" class="kanban-column col-completed @(expandedMobileColumn == "completed" ? "is-expanded" : "")">
                <div class="kanban-col-header" @onclick='() => ToggleMobileColumn("completed")'>
                    <div class="kanban-col-title-wrap">
                        <div class="kanban-col-icon icon-completed">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                                <polyline points="22 4 12 14.01 9 11.01"/>
                            </svg>
                        </div>
                        <span class="kanban-col-title">Đã hoàn thành</span>
                    </div>
                    <div class="kanban-header-right">
                        <span class="kanban-badge badge-completed">@CompletedOrders.Count</span>
                        <svg class="accordion-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </div>
                </div>
                <div class="kanban-cards-wrapper">
                <div class="kanban-cards">
                    @if (!CompletedOrders.Any())
                    {
                        <div class="kanban-empty">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                                <polyline points="22 4 12 14.01 9 11.01"/>
                            </svg>
                            <p>Chưa có đơn hoàn thành</p>
                        </div>
                    }
                    @foreach (var order in CompletedOrders)
                    {
                        <div class="kanban-card card-completed">
                            <div class="kanban-card-header">
                                <div class="order-id order-id-completed">#ORD-@order.OrderId</div>
                                <div class="order-time">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                                    </svg>
                                    @order.OrderDate.ToString("HH:mm")
                                </div>
                            </div>
                            <div class="kanban-card-meta">
                                <div class="meta-item">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="3"/>
                                    </svg>
                                    @(string.IsNullOrEmpty(order.TableNumber) ? "Quầy" : "Bàn " + order.TableNumber)
                                </div>
                                <div class="completed-check">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                        <polyline points="20 6 9 17 4 12"/>
                                    </svg>
                                    Đã giao
                                </div>
                            </div>
                            <div class="kanban-divider"></div>
                            <ul class="order-items-list">
                                @foreach (var item in order.Items)
                                {
                                    <li class="order-item">
                                        <div class="pos-item-header">
                                            <span class="pos-item-qty">@item.Quantity×</span>
                                            <span class="pos-item-name">@item.DrinkName</span>
                                        </div>
                                        <div class="pos-item-tags">
                                            @if (!string.IsNullOrEmpty(item.SizeName))
                                            {
                                                <span class="pos-tag pos-tag-size">Size: @item.SizeName</span>
                                            }
                                            <span class="pos-tag pos-tag-base">Đá: @item.IceLevel% · Đường: @item.SweetnessLevel%</span>
                                            @if (item.ToppingNames != null && item.ToppingNames.Any())
                                            {
                                                <span class="pos-tag pos-tag-topping">+ @string.Join(", ", item.ToppingNames)</span>
                                            }
                                            @if (!string.IsNullOrEmpty(item.ItemNote))
                                            {
                                                <span class="pos-tag pos-tag-note">Ghi chú: @item.ItemNote</span>
                                            }
                                        </div>
                                    </li>
                                }
                            </ul>
                            <div class="kanban-divider"></div>
                            <div class="kanban-card-footer d-flex justify-content-between align-items-center w-100">
                                <div class="completed-amount">@order.FinalAmount.ToString("N0")đ</div>
                                <button class="btn-kanban btn-accept" @onclick="() => PrintInvoice(order)" style="background-color: #f0fdf4; color: #16a34a; border-color: #bbf7d0; font-size: 11px; padding: 4px 8px; border-radius: 6px;">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                                        <polyline points="6 9 6 2 18 2 18 9"/>
                                        <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
                                        <rect x="6" y="14" width="12" height="8"/>
                                    </svg>
                                    In hóa đơn
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>


    }

    <!-- Modal Quản lý trạng thái món - Premium POS Inventory Bento Drawer (Light / White Theme) -->
    @if (showMenuModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.45); backdrop-filter: blur(6px); z-index: 1060;">
            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" style="max-width: 1060px;">
                <div class="modal-content border-0 shadow-lg" style="background: #ffffff; border-radius: 20px; overflow: hidden; color: #1e293b;">
                    
                    <!-- Top Cinematic Header (Bright Clean White) -->
                    <div class="px-4 py-4 d-flex justify-content-between align-items-center" style="background: #ffffff; border-bottom: 1px solid #e2e8f0;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; border-radius: 12px; background: #fff7ed; border: 1px solid #ffedd5;">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ea580c" stroke-width="2">
                                    <path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/>
                                    <line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/>
                                </svg>
                            </div>
                            <div>
                                <h5 class="fw-bold m-0" style="font-size: 1.15rem; color: #0f172a; letter-spacing: -0.3px;">Kiểm soát Tình trạng Món</h5>
                                <div class="small text-secondary mt-1">Bấm nút gạt trên thẻ món để cập nhật trạng thái Còn hàng / Hết nguyên liệu</div>
                            </div>
                        </div>
                        
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn-close ms-2" @onclick="CloseMenuModal"></button>
                        </div>
                    </div>

                    <!-- Filter & Search Toolbar -->
                    <div class="px-4 py-3 d-flex flex-wrap justify-content-between align-items-center gap-3" style="background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                        <div class="position-relative" style="flex: 1; min-width: 260px;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%);">
                                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                            </svg>
                            <input type="text" class="form-control" placeholder="Tìm kiếm nhanh tên món đồ uống..." 
                                   @bind="menuSearchQuery" @bind:event="oninput"
                                   style="background: #ffffff; border: 1px solid #cbd5e1; color: #0f172a; border-radius: 10px; padding-left: 40px; font-size: 14px; box-shadow: 0 1px 2px rgba(0,0,0,0.03);" />
                        </div>

                        <!-- Segment Filter Pills -->
                        <div class="d-flex gap-1 p-1" style="background: #ffffff; border-radius: 10px; border: 1px solid #e2e8f0;">
                            <button class="btn btn-sm px-3 fw-bold @(menuFilterStatus == "ALL" ? "text-dark" : "text-secondary")"
                                    style="@(menuFilterStatus == "ALL" ? "background: #fef3c7; border: 1px solid #fde68a; border-radius: 8px; color: #b45309;" : "border: none;")"
                                    @onclick='() => menuFilterStatus = "ALL"'>
                                Tất cả (@menuDrinks.Count)
                            </button>
                            <button class="btn btn-sm px-3 fw-bold @(menuFilterStatus == "ACTIVE" ? "text-white" : "text-secondary")"
                                    style="@(menuFilterStatus == "ACTIVE" ? "background: #10b981; border-radius: 8px;" : "border: none;")"
                                    @onclick='() => menuFilterStatus = "ACTIVE"'>
                                Còn hàng (@menuDrinks.Count(d => d.IsActive))
                            </button>
                            <button class="btn btn-sm px-3 fw-bold @(menuFilterStatus == "INACTIVE" ? "text-white" : "text-secondary")"
                                    style="@(menuFilterStatus == "INACTIVE" ? "background: #f43f5e; border-radius: 8px;" : "border: none;")"
                                    @onclick='() => menuFilterStatus = "INACTIVE"'>
                                Hết hàng (@menuDrinks.Count(d => !d.IsActive))
                            </button>
                        </div>
                    </div>

                    <!-- Bento Cards Grid Area -->
                    <div class="modal-body p-4" style="background: #f8fafc; max-height: 65vh; overflow-y: auto;">
                        @if (isMenuLoading)
                        {
                            <div class="text-center py-5 my-3">
                                <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
                                <div class="mt-3 text-secondary fw-bold">Đang tải đồng bộ dữ liệu thực đơn...</div>
                            </div>
                        }
                        else if (!FilteredDrinks.Any())
                        {
                            <div class="text-center py-5 my-4">
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5">
                                    <circle cx="12" cy="12" r="10"/><line x1="8" y1="12" x2="16" y2="12"/>
                                </svg>
                                <div class="mt-3 text-secondary fw-bold">Không tìm thấy món phù hợp</div>
                            </div>
                        }
                        else
                        {
                            <div class="pos-bento-grid">
                                @foreach (var drink in FilteredDrinks)
                                {
                                    <div class="pos-bento-card @(!drink.IsActive ? "is-inactive" : "")">
                                        <!-- Card Top Image & Info -->
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="pos-bento-img-wrap">
                                                <img src="@(string.IsNullOrEmpty(drink.ImageUrl) ? "/images/default-drink.png" : drink.ImageUrl)" alt="@drink.DrinkName" />
                                            </div>
                                            <div style="flex: 1; min-width: 0;">
                                                <div class="pos-bento-name text-truncate" title="@drink.DrinkName">@drink.DrinkName</div>
                                                <div class="pos-bento-price mt-1">@drink.BasePrice.ToString("N0")đ</div>
                                            </div>
                                        </div>

                                        <!-- Card Bottom Action Button -->
                                        <div class="mt-3 pt-3" style="border-top: 1px solid #f1f5f9;">
                                            <button class="pos-bento-toggle-btn @(drink.IsActive ? "active-state" : "inactive-state")"
                                                    @onclick="() => ToggleDrinkStatusStaff(drink)">
                                                <span class="status-indicator"></span>
                                                <span class="status-label">@(drink.IsActive ? "ĐANG PHỤC VỤ" : "TẠM HẾT HÀNG")</span>
                                                <span class="status-hint">@(drink.IsActive ? "Chạm tắt" : "Chạm bật")</span>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Footer -->
                    <div class="modal-footer px-4 py-3 d-flex justify-content-between align-items-center" style="background: #ffffff; border-top: 1px solid #e2e8f0;">
                        <button class="btn btn-secondary px-4 py-2 fw-bold" style="border-radius: 10px;" @onclick="CloseMenuModal">Đóng cửa sổ</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isWaiter = false;
    private string expandedMobileColumn = "pending";
    private void ToggleMobileColumn(string column)
    {
        if (expandedMobileColumn == column) expandedMobileColumn = "";
        else expandedMobileColumn = column;
    }
    private bool isLoading = true;
    private List<OrderDto> activeOrders = new();
    private HubConnection? hubConnection;
    private List<SystemConfigDto> configs = new();

    private List<OrderDto> PendingOrders => activeOrders.Where(o => o.OrderStatus == 0 && (o.Payment == null || o.Payment.PaymentStatus == 0)).ToList();
    private List<OrderDto> PaidOrders => activeOrders.Where(o => o.OrderStatus == 0 && o.Payment != null && o.Payment.PaymentStatus == 1).ToList();
    private List<OrderDto> PreparingOrders => activeOrders.Where(o => o.OrderStatus == 1).ToList();
    private List<OrderDto> CompletedOrders => activeOrders.Where(o => o.OrderStatus == 2).ToList();

    // Quản lý trạng thái món
    private bool showMenuModal = false;
    private bool isMenuLoading = false;
    private string menuSearchQuery = "";
    private string menuFilterStatus = "ALL";
    private List<DrinkDto> menuDrinks = new();

    private IEnumerable<DrinkDto> FilteredDrinks
    {
        get
        {
            var query = menuDrinks.AsEnumerable();
            if (menuFilterStatus == "ACTIVE") query = query.Where(d => d.IsActive);
            else if (menuFilterStatus == "INACTIVE") query = query.Where(d => !d.IsActive);

            if (!string.IsNullOrWhiteSpace(menuSearchQuery))
            {
                query = query.Where(d => d.DrinkName.Contains(menuSearchQuery, StringComparison.OrdinalIgnoreCase));
            }
            return query;
        }
    }

    private async Task OpenMenuStatusModal()
    {
        showMenuModal = true;
        isMenuLoading = true;
        try
        {
            menuDrinks = await MenuApi.GetDrinksAsync("vi", null, true);
        }
        finally
        {
            isMenuLoading = false;
        }
    }

    private void CloseMenuModal()
    {
        showMenuModal = false;
    }

    private async Task ToggleDrinkStatusStaff(DrinkDto drink)
    {
        bool success = await MenuApi.ToggleDrinkStatusAsync(drink.DrinkId);
        if (success)
        {
            drink.IsActive = !drink.IsActive;
            StateHasChanged();
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "Cập nhật trạng thái món thất bại!");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isWaiter = authState.User.IsInRole("Waiter");
        expandedMobileColumn = isWaiter ? "pending" : "preparing";

        await LoadOrders();
        await LoadConfig();
        await SetupSignalR();
    }

    private async Task LoadConfig()
    {
        try
        {
            configs = await ConfigApi.GetConfigsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Lỗi khi tải cấu hình");
        }
    }

    private async Task LoadOrders()
    {
        try
        {
            isLoading = true;
            activeOrders = await OrderApi.GetActiveOrdersAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SetupSignalR()
    {
        var apiBaseUrl = Config["BackendApiUrl"] ?? "http://localhost:5153";
        var token = await LocalStorage.GetItemAsync("authToken");

        hubConnection = new HubConnectionBuilder()
            .WithUrl($"{apiBaseUrl.TrimEnd('/')}/orderhub", options =>
            {
                if (!string.IsNullOrEmpty(token))
                {
                    options.AccessTokenProvider = () => Task.FromResult<string?>(token);
                }
            })
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<OrderDto>("ReceiveNewOrder", (order) =>
        {
            if (!activeOrders.Any(o => o.OrderId == order.OrderId))
            {
                activeOrders.Insert(0, order);
                StateHasChanged();
            }
        });

        hubConnection.On<StatusUpdateEvent>("ReceiveStatusUpdateAtPOS", (data) =>
        {
            var order = activeOrders.FirstOrDefault(o => o.OrderId == data.OrderId);
            if (order != null)
            {
                order.OrderStatus = data.Status;
                order.OrderStatusName = data.StatusName;
                if (data.PaymentStatus.HasValue && order.Payment != null)
                {
                    order.Payment.PaymentStatus = data.PaymentStatus.Value;
                }
                StateHasChanged();
            }
        });

        hubConnection.Closed += (error) => { StateHasChanged(); return Task.CompletedTask; };
        hubConnection.Reconnected += (id) => { StateHasChanged(); return Task.CompletedTask; };

        try
        {
            await hubConnection.StartAsync();
            await hubConnection.InvokeAsync("JoinStaffGroup");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Lỗi khi kết nối SignalR");
        }
    }

    private async Task UpdateOrderStatus(int orderId, byte status)
    {
        bool success = await OrderApi.UpdateOrderStatusAsync(orderId, status);
        if (success)
        {
            var order = activeOrders.FirstOrDefault(o => o.OrderId == orderId);
            if (order != null) { order.OrderStatus = status; StateHasChanged(); }
        }
    }

    private async Task CancelOrder(int orderId)
    {
        string? reason = await JSRuntime.InvokeAsync<string?>("prompt", "Nhập lý do hủy đơn (ví dụ: Hết nguyên liệu, Khách yêu cầu hủy...):", "Hết nguyên liệu");
        if (reason == null) return; // Người dùng nhấn Hủy bỏ prompt

        bool success = await OrderApi.UpdateOrderStatusAsync(orderId, 3, reason); // 3 = Cancelled
        if (success)
        {
            var order = activeOrders.FirstOrDefault(o => o.OrderId == orderId);
            if (order != null) { activeOrders.Remove(order); StateHasChanged(); }
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "Hủy đơn thất bại. Vui lòng thử lại.");
        }
    }

    private async Task ConfirmCashPayment(int orderId)
    {
        bool success = await OrderApi.ConfirmCashPaymentAsync(orderId);
        if (success)
        {
            var order = activeOrders.FirstOrDefault(o => o.OrderId == orderId);
            if (order != null && order.Payment != null)
            {
                order.Payment.PaymentStatus = 1; // Success
                StateHasChanged();
            }
        }
    }

    private async Task PrintInvoice(OrderDto order)
    {
        var storeName = configs.FirstOrDefault(c => c.ConfigKey == "StoreName")?.ConfigValue ?? "NGOC UWU COFFEE";
        var storeAddress = configs.FirstOrDefault(c => c.ConfigKey == "StoreAddress")?.ConfigValue ?? "Đ/c: 123 Đường Sách, TP. Hồ Chí Minh";
        var storePhone = configs.FirstOrDefault(c => c.ConfigKey == "StorePhone")?.ConfigValue ?? "SĐT: 0123.456.789";
        var storeWifi = configs.FirstOrDefault(c => c.ConfigKey == "StoreWifi")?.ConfigValue;

        var sb = new System.Text.StringBuilder();
        sb.Append("<div class=\"invoice-box\">");
        sb.Append("<div class=\"text-center\">");
        sb.Append($"<div class=\"header-title\">{storeName}</div>");
        sb.Append($"<div>{storeAddress}</div>");
        sb.Append($"<div>{storePhone}</div>");
        if (!string.IsNullOrEmpty(storeWifi))
        {
            sb.Append($"<div>WiFi: {storeWifi}</div>");
        }
        sb.Append("<div class=\"divider\"></div>");
        sb.Append("<div class=\"bold\">HÓA ĐƠN THANH TOÁN</div>");
        sb.Append($"<div>Mã đơn: #ORD-{order.OrderId}</div>");
        sb.Append($"<div>Ngày: {order.OrderDate:dd/MM/yyyy HH:mm}</div>");
        sb.Append($"<div>Bàn: {order.TableNumber ?? "Quầy"}</div>");
        sb.Append("</div>");
        sb.Append("<div class=\"divider\"></div>");
        sb.Append("<table class=\"item-table\">");
        sb.Append("<thead><tr><th>Món</th><th class=\"text-right\">SL</th><th class=\"text-right\">T.Tiền</th></tr></thead>");
        sb.Append("<tbody>");
        foreach (var item in order.Items)
        {
            sb.Append("<tr>");
            sb.Append($"<td>{item.DrinkName}");
            if (!string.IsNullOrEmpty(item.SizeName))
            {
                sb.Append($"<br/><small>Size: {item.SizeName}</small>");
            }
            sb.Append($"<br/><small>Đá: {item.IceLevel}% · Đường: {item.SweetnessLevel}%");
            if (item.ToppingNames != null && item.ToppingNames.Any())
            {
                sb.Append($" · Topping: {string.Join(", ", item.ToppingNames)}");
            }
            if (!string.IsNullOrEmpty(item.ItemNote))
            {
                sb.Append($" · {item.ItemNote}");
            }
            sb.Append("</small></td>");
            sb.Append($"<td class=\"text-right\">{item.Quantity}</td>");
            sb.Append($"<td class=\"text-right\">{(item.UnitPrice * item.Quantity):N0}đ</td>");
            sb.Append("</tr>");
        }
        sb.Append("</tbody></table>");
        sb.Append("<div class=\"divider\"></div>");
        sb.Append("<table style=\"width: 100%; border-collapse: collapse;\">");
        sb.Append($"<tr><td style=\"text-align: right; padding: 4px 0;\">Tổng cộng:</td><td style=\"width: 100px; text-align: right; padding: 4px 0;\">{order.TotalAmount:N0}đ</td></tr>");
        sb.Append($"<tr><td style=\"text-align: right; padding: 4px 0;\">Giảm giá:</td><td style=\"width: 100px; text-align: right; padding: 4px 0;\">{order.DiscountAmount:N0}đ</td></tr>");
        sb.Append($"<tr><td style=\"text-align: right; padding: 4px 0; font-weight: bold; font-size: 16px;\">Thành tiền:</td><td style=\"width: 100px; text-align: right; padding: 4px 0; font-weight: bold; font-size: 16px;\">{order.FinalAmount:N0}đ</td></tr>");
        sb.Append("</table>");
        sb.Append("<div class=\"divider\"></div>");
        sb.Append("<div class=\"text-center\" style=\"margin-top: 15px; font-style: italic;\">");
        sb.Append("Cảm ơn Quý khách. Hẹn gặp lại!");
        sb.Append("</div>");
        sb.Append("</div>");

        await JSRuntime.InvokeVoidAsync("printInvoice", sb.ToString());
    }

    private void GoBack() => NavigationManager.NavigateTo("/account");

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null) await hubConnection.DisposeAsync();
    }

    public class StatusUpdateEvent
    {
        public int OrderId { get; set; }
        public byte Status { get; set; }
        public string StatusName { get; set; } = string.Empty;
        public byte? PaymentStatus { get; set; }
    }
}
